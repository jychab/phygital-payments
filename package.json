{
  "name": "phygital-payments",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "generate:client": "codama run js && node scripts/patch-lazorkit-program-address.mjs && node scripts/patch-lazorkit-instructions.mjs",
    "dev": "pnpm --filter app dev",
    "build:app": "pnpm --filter app build",
    "preview:app": "pnpm --filter app preview",
    "deploy:app": "pnpm --filter app deploy",
    "deploy:api": "pnpm --filter @phygital/api-worker deploy",
    "deploy:signer": "pnpm --filter @phygital/signer-worker deploy"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.2"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.3",
    "@codama/renderers-js": "^2.3.1",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "codama": "^1.10.0",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bufferutil",
      "esbuild",
      "keccak",
      "sharp",
      "unrs-resolver",
      "utf-8-validate",
      "workerd"
    ]
  }
}
