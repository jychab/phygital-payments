{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // Runtime types (workerd) + the CloudflareEnv interface come from the
    // generated ../cloudflare-env.d.ts included below — not @cloudflare/workers-types.
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.ts", "../cloudflare-env.d.ts"]
}
