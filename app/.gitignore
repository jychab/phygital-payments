# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets stay local; example templates are committed)
.env*
.dev.vars
!.env.example
!.dev.vars.example

# cloudflare / opennext build artifacts
.open-next/
.wrangler/
# NOTE: cloudflare-env.d.ts is committed on purpose — tsc/build depend on it as
# the CloudflareEnv source of truth, and CI can't regenerate it (needs .dev.vars).

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
graphify-out/