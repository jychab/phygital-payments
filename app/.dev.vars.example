# Local secrets + public config for `next dev` and Wrangler.
# Copied to `.dev.vars` (gitignored). Do not use `.env` / `.env.local`.

NEXTJS_ENV=development

# Solana
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Backend Worker (pnpm --filter api dev → :8787)
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# Fee balance top-up accumulator (must match API TOP_UP_ACCUMULATOR)
# NEXT_PUBLIC_TOP_UP_ACCUMULATOR=
