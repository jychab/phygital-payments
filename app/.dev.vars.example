# Local secrets + public config for `next dev` and Wrangler.
# Copied to `.dev.vars` (gitignored). Do not use `.env` / `.env.local`.

NEXTJS_ENV=development

# Solana
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_FEE_PAYER_PUBLIC_KEY=

# Worker secrets (Wrangler / OpenNext)
# FEE_PAYER_SECRET_KEY=
# HELIUS_WEBHOOK_AUTH=

# HMAC secret for device pay keys (required for Pay provision + open)
# PAY_HMAC_SECRET=

# Token catalog (optional — without these, Collect falls back to USDC-only)
# JUPITER_API_KEY=
