{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:next": "next dev",
    "dev:signer": "pnpm --filter @phygital/signer-worker dev",
    "dev:api": "pnpm --filter @phygital/api-worker dev",
    "dev:workers": "node scripts/dev-workers.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "preview": "node scripts/dev-workers.mjs",
    "deploy": "pnpm --filter @phygital/signer-worker deploy && pnpm --filter @phygital/api-worker deploy && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:signer": "pnpm --filter @phygital/signer-worker deploy",
    "deploy:api": "pnpm --filter @phygital/api-worker deploy",
    "deploy:app": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "pnpm --filter @phygital/api-worker db:migrate:local",
    "db:migrate:signer:local": "pnpm --filter @phygital/signer-worker db:migrate:local",
    "provision-fee-payer": "pnpm --filter @phygital/signer-worker provision-fee-payer",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@opennextjs/cloudflare": "^1.3.0",
    "@solana/kit": "^7.0.0",
    "@tanstack/query-sync-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lazor-kit": "workspace:*",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "phygital-token-sdk": "^0.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250726.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.80.0"
  }
}
