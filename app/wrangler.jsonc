{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phygital-payments-app",
  "main": "./custom-worker.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "phygital-payments-app"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TRANSFER_SUBMITTER", "class_name": "TransferSubmitterDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TransferSubmitterDO"]
    }
  ],
  "vars": {
    "NEXT_PUBLIC_PRIVY_APP_ID": "cmqt76oza019h0ck6296p44a8",
    "NEXT_PUBLIC_SOLANA_RPC_URL": "https://rpc.revibase.com",
    "NEXT_PUBLIC_SOLANA_CLUSTER": "mainnet",
    "NEXT_PUBLIC_FEE_PAYER_PUBLIC_KEY": ""
  }
}
