NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional override (defaults: mainnet Circle USDC / devnet 4zMMC9…)
# NEXT_PUBLIC_USDC_MINT=

# Sponsored fee-payer (optional — enable "Sponsored fees" in Get paid UI).
# Public key only; the private key + Privy verification key are Cloudflare
# bindings/secrets, not NEXT_PUBLIC env — see `app/.dev.vars.example`
# (local dev) and `wrangler secret put ...` (production).
NEXT_PUBLIC_FEE_PAYER_PUBLIC_KEY=
